<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
                          http://www.kde.org/standards/kcfg/1.0/kcfg.xsd" >
    <kcfgfile arg="true"/>
    <group name="Effect-bettertransition">
        <entry name="FadeOutDuration" type="Int">
            <default>150</default>
        </entry>
        <entry name="HoldDuration" type="Int">
            <default>700</default>
        </entry>
        <entry name="FadeInDuration" type="Int">
            <default>250</default>
        </entry>
        <entry name="FadeStrength" type="Int">
            <default>100</default>
        </entry>
        <entry name="OnlyOverlapping" type="Bool">
            <default>true</default>
        </entry>
        <entry name="IncludeSpecialWindows" type="Bool">
            <default>false</default>
        </entry>
        <!-- Temporarily paint the covering windows above the raised window while
             they fade out. Stronger reveal, but their (inactive) decorations and
             shadows briefly cover the raised window, which can read as the
             raised window losing focus. -->
        <entry name="ElevateCoveringWindows" type="Bool">
            <default>false</default>
        </entry>
        <!-- Fade the raised window itself when a single huge window covers it -->
        <entry name="LargeCovererScreenRatio" type="Int">
            <default>75</default>
        </entry>
        <!-- Scale-in fallback for windows that were almost completely covered -->
        <entry name="ScaleInThreshold" type="Int">
            <default>90</default>
        </entry>
        <entry name="ScaleInDuration" type="Int">
            <default>400</default>
        </entry>
        <entry name="ScaleInStartScale" type="Int">
            <default>90</default>
        </entry>
    </group>
</kcfg>
