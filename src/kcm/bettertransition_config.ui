   <item row="5" column="0" colspan="2">
    <widget class="QCheckBox" name="kcfg_IncludeSpecialWindows">
     <property name="text">
      <string>Also fade special windows such as popups, notifications and tooltips (panels and the desktop are never touched)</string>
     </property>
    </widget>
   </item>
   <item row="6" column="0" colspan="2">
    <widget class="QCheckBox" name="kcfg_ElevateCoveringWindows">
     <property name="text">
      <string>Paint the covering windows above the raised window while they fade out (stronger reveal)</string>
     </property>
     <property name="toolTip">
      <string>Their inactive decorations and shadows briefly cover the raised window, which can look like the window is losing focus. Leave this off if you see flicker.</string>
