     <property name="minimum">
      <number>0</number>
     </property>
     <property name="maximum">
      <number>10000</number>
     </property>
     <property name="singleStep">
      <number>10</number>
     </property>
     <property name="toolTip">
      <string>How long the minimum opacity is kept before fading back in. Also delays the raised window's own fade-in.</string>
